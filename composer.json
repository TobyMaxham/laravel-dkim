{
    "name": "tobymaxham/laravel-dkim",
    "description": "Add DKIM signatures to your Laravel mails without replacing the mailer. Multiple domains, key generator and DNS check included.",
    "keywords": [
        "TobyMaxham",
        "laravel",
        "dkim",
        "mail",
        "email",
        "signing",
        "dns"
    ],
    "homepage": "https://github.com/TobyMaxham/laravel-dkim",
    "license": "MIT",
    "authors": [
        {
            "name": "TobyMaxham",
            "email": "git@maxham.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-openssl": "*",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/mail": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "symfony/mime": "^7.2|^8.0"
    },
    "autoload": {
        "psr-4": {
            "TobyMaxham\\LaravelDkimSigner\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TobyMaxham\\LaravelDkimSigner\\Tests\\": "tests"
        }
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.3",
        "symfony/yaml": "^7.2|^8.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TobyMaxham\\LaravelDkimSigner\\DkimSignerProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "4.x-dev"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "XDEBUG_MODE=coverage vendor/bin/pest --coverage",
        "cs-fix": "./vendor/bin/pint src/ tests/",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
